{% for member in members %}
<tr class="text-center">
  <td class="px-4 py-2 border-b">{{ member.name }}</td>
  <td class="px-4 py-2 border-b">{{ member.meal }}</td>
  <td class="px-4 py-2 border-b">{{ member.meal_rate }}</td>
  <td class="px-4 py-2 border-b">{{ member.bill }}</td>
  <td class="px-4 py-2 border-b">{{ member.save }}</td>
  <td class="px-4 py-2 border-b">{{ member.get_paid }}</td>
  <td class="px-4 py-2 border-b">{{ member.should_paid }}</td>
</tr>
{% endfor %}

